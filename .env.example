# Llave de la API de Anthropic (console.anthropic.com). Solo vive en el servidor.
ANTHROPIC_API_KEY=
# Profundidad del análisis: low | medium | high (high = más preciso, más caro y lento)
AI_EFFORT=medium

# Supabase (Project Settings → API). La URL y la publishable key son públicas;
# la secret key solo en el servidor.
PB_SUPABASE_URL=
PB_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mercado Pago (Tus integraciones → credenciales de producción).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks); valida que los avisos vengan de Mercado Pago.
MP_WEBHOOK_SECRET=
# Pesos por dólar: los precios están en US$ y Mercado Pago cobra en MXN.
MP_USD_RATE=18.5
MP_CURRENCY=MXN
# Dominio público (para las páginas de regreso y el webhook), p. ej. https://pronosticos.vercel.app
SITE_URL=

# Para que Vercel Cron pueda llamar /api/cron/calificar (cualquier texto largo y aleatorio).
CRON_SECRET=
